#####################################################################
# SDGT — Sistema de Diagnóstico da Gestão Tributária Municipal
# Copie para .env e ajuste. Documentação: docs/04-manual-tecnico.md
#####################################################################
APP_NAME=SDGT
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_VERSAO=1.0.0
APP_TIMEZONE=America/Araguaina
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ---------- Banco de dados ----------
# Produção / homologação: Microsoft SQL Server
# DB_CONNECTION=sqlsrv
# DB_HOST=sqlserver
# DB_PORT=1433
# DB_DATABASE=sdgt
# DB_USERNAME=sa
# DB_PASSWORD=
# DB_TRUST_SERVER_CERTIFICATE=true
# Desenvolvimento rápido: SQLite (arquivo database/database.sqlite)
DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# ---------- E-mail (EP10) ----------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="nao-responda@tceto.tc.br"
MAIL_FROM_NAME="SDGT - TCE/TO"

# ---------- Identidade do órgão (permite replicar para outros Tribunais) ----------
SDGT_ORGAO_NOME="Tribunal de Contas do Estado do Tocantins"
SDGT_ORGAO_SIGLA="TCE/TO"
SDGT_ORGAO_UF=TO
SDGT_NOME_SISTEMA="Diagnóstico da Gestão Tributária Municipal"
SDGT_QTD_RELATORIAS=6

# ---------- Seed ----------
SDGT_ADMIN_EMAIL=admin@tceto.tc.br
SDGT_ADMIN_PASSWORD=Sdgt@2026
# true = carrega base fictícia de demonstração (3 ciclos, 139 municípios)
SDGT_SEED_DEMO=false
# true = exibe seletor de usuários de teste no login (NUNCA em produção; ignorado se APP_ENV=production)
SDGT_LOGIN_SIMULADO=false

# ---------- Regras de negócio (decisões pendentes do cliente) ----------
SDGT_FAIXA_BAIXA_ATE=49.99
SDGT_FAIXA_MEDIA_ATE=74.99
SDGT_DIAS_PREENCHIMENTO=15
SDGT_DIAS_UTEIS_ASSINATURA=1
SDGT_DIAS_LEMBRETE=3
SDGT_EVIDENCIA_MAX_KB=20480
SDGT_HORARIO_ROTINA=06:00

# ---------- Integrações (ver docs/02-integracoes-pendentes.md) ----------
# GOV.BR: fake | oidc
GOVBR_DRIVER=fake
GOVBR_CLIENT_ID=
GOVBR_CLIENT_SECRET=
GOVBR_REDIRECT_URI="${APP_URL}/login/govbr/callback"
GOVBR_URL_PROVIDER=https://sso.staging.acesso.gov.br
# Certificado digital: fake | header (mTLS no proxy reverso)
CERTIFICADO_DRIVER=fake
CERTIFICADO_HEADER=X-SSL-CLIENT-CERT
# Assinatura: simples | icp_tce
ASSINATURA_DRIVER=simples
ASSINATURA_ICP_URL=
ASSINATURA_ICP_TOKEN=
# CADUN: local | api
CADUN_DRIVER=local
CADUN_API_URL=
CADUN_API_TOKEN=
# Calendário Oficial: local | api
CALENDARIO_DRIVER=local
CALENDARIO_API_URL=
CALENDARIO_API_TOKEN=
CALENDARIO_FERIADOS="01-01,04-21,05-01,09-07,10-05,10-12,11-02,11-15,11-20,12-25"
# SFG (alertas): log | api
SFG_DRIVER=log
SFG_API_URL=
SFG_API_TOKEN=
# Repositório de arquivos (disk do Laravel): local | <disk customizado da API do TCE>
SDGT_EVIDENCIAS_DISK=local
SDGT_MATERIAIS_DISK=local
