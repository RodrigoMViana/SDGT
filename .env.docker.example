# =====================================================================
# Variáveis do ambiente Docker (homologação). Copie para .env.docker.
# Para produção: APP_ENV=production, APP_DEBUG=false, SDGT_SEED_DEMO=false,
# SDGT_LOGIN_SIMULADO=false, drivers de integração reais e SMTP do Tribunal.
# =====================================================================
APP_NAME=SDGT
APP_ENV=homologacao
APP_DEBUG=false
# Gere com: docker compose run --rm --no-deps app php artisan key:generate --show
APP_KEY=
APP_URL=http://localhost:8080
APP_TIMEZONE=America/Araguaina
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=sqlsrv
DB_HOST=sqlserver
DB_PORT=1433
DB_DATABASE=sdgt
DB_USERNAME=sa
# Deve ser igual à senha do SA do contêiner sqlserver (docker-compose.yml: DB_PASSWORD)
DB_PASSWORD=Sdgt#Sql2026
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=true

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS="nao-responda@tceto.tc.br"
MAIL_FROM_NAME="SDGT - TCE/TO"

SDGT_AUTO_MIGRATE=true
SDGT_SEED_DEMO=true
SDGT_LOGIN_SIMULADO=true
SDGT_ADMIN_EMAIL=admin@tceto.tc.br
SDGT_ADMIN_PASSWORD=Sdgt@2026

GOVBR_DRIVER=fake
CERTIFICADO_DRIVER=fake
ASSINATURA_DRIVER=simples
CADUN_DRIVER=local
CALENDARIO_DRIVER=local
SFG_DRIVER=log
